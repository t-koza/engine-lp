# --- LINE Messaging API ---
# LINE Developers Console > Messaging API設定 から取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- OpenAI API ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 使用モデル (既定: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- サーバー ---
PORT=3000

# --- 運用 ---
# エスカレーション通知先 (LINEユーザーID または グループID)。空ならログ出力のみ
ESCALATION_NOTIFY_TO=
# 営業担当者の連絡先（プロンプトに差し込まれる）
SHOP_NAME=合同会社ENGINE
SHOP_AGENT_NAME=田中
SHOP_AGENT_PHONE=03-0000-0000
SHOP_BUSINESS_HOURS=平日 10:00〜19:00
